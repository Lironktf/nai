{
  "manifest_version": 3,
  "name": "NAI Meet Verification",
  "description": "Run in-meeting NAI verification for Google Meet without leaving the call.",
  "version": "0.1.0",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://meet.usenai.ca/*",
    "http://localhost:5174/*",
    "https://auth.usenai.ca/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NAI Meet Verification"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.usenai.ca/*", "http://localhost:5174/*"],
      "js": ["content/meet-panel.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://auth.usenai.ca/*", "http://localhost:5173/*"],
      "js": ["content/auth-bridge.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
